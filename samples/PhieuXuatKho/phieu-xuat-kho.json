{
  "version": 1,
  "name": "PhieuXuatKho",
  "dataSource": "items",
  "page": { "width": 210, "height": 297, "margin": 10 },
  "groups": [ { "name": "kho", "expression": "kho" } ],
  "bands": [
    { "type": "pageHeader", "height": 8, "elements": [
      { "x": 0, "y": 0, "width": 130, "height": 6, "expression": "company" },
      { "x": 140, "y": 0, "width": 50, "height": 6, "align": "right", "expression": "'Ngày: ' + date" }
    ] },
    { "type": "reportHeader", "height": 14, "elements": [
      { "x": 0, "y": 2, "width": 190, "height": 8, "align": "center", "expression": "title" }
    ] },
    { "type": "groupHeader", "group": "kho", "height": 7, "elements": [
      { "x": 0, "y": 0, "width": 190, "height": 6, "expression": "'Kho: ' + kho" }
    ] },
    { "type": "groupHeader", "group": "kho", "height": 6, "elements": [
      { "x": 0, "y": 0, "width": 40, "height": 5, "text": "Mã" },
      { "x": 40, "y": 0, "width": 90, "height": 5, "text": "Tên vật tư" },
      { "x": 130, "y": 0, "width": 25, "height": 5, "align": "right", "text": "SL" },
      { "x": 160, "y": 0, "width": 30, "height": 5, "text": "ĐVT" },
      { "type": "line", "x": 0, "y": 5.5, "width": 190, "height": 0 }
    ] },
    { "type": "detail", "height": 6, "elements": [
      { "x": 0, "y": 0, "width": 40, "height": 5, "expression": "code" },
      { "x": 40, "y": 0, "width": 90, "height": 5, "wrap": true, "expression": "name" },
      { "x": 130, "y": 0, "width": 25, "height": 5, "align": "right", "expression": "Format(qty, 'N0')" },
      { "x": 160, "y": 0, "width": 30, "height": 5, "expression": "unit" }
    ] },
    { "type": "groupFooter", "group": "kho", "height": 8, "elements": [
      { "type": "line", "x": 0, "y": 0.5, "width": 190, "height": 0 },
      { "x": 0, "y": 1, "width": 190, "height": 6, "align": "right", "expression": "'Tổng ' + kho + ': ' + Format(tongKho, 'N0')" }
    ] },
    { "type": "reportFooter", "height": 10, "elements": [
      { "x": 0, "y": 2, "width": 190, "height": 6, "align": "right", "expression": "'TỔNG CỘNG: ' + Format(tong, 'N0')" }
    ] },
    { "type": "pageFooter", "height": 8, "elements": [
      { "x": 0, "y": 2, "width": 190, "height": 6, "align": "center", "expression": "'Trang ' + PageNumber + '/' + PageCount" }
    ] }
  ],
  "aggregates": [
    { "name": "tongKho", "function": "sum", "expression": "qty", "group": "kho" },
    { "name": "tong", "function": "sum", "expression": "qty" }
  ]
}
